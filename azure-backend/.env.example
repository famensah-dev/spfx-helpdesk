DESKPILOT_TENANT_ID=
# App registration exposing access_as_user (requestedAccessTokenVersion must be 2).
DESKPILOT_CLIENT_ID=
# Server-only credential. Use a Key Vault reference in Azure application settings.
DESKPILOT_CLIENT_SECRET=
# Comma-separated allowed frontend client IDs (SPFx extensibility principal and/or SPA).
DESKPILOT_ALLOWED_CLIENT_IDS=
DESKPILOT_ALLOWED_ORIGINS=https://yourtenant.sharepoint.com
DESKPILOT_SITE_URL=https://yourtenant.sharepoint.com/sites/helpdesk
DESKPILOT_PAGE_URL=https://yourtenant.sharepoint.com/sites/helpdesk/SitePages/DeskPilot.aspx
DESKPILOT_TICKETS_LIST_NAME=Tickets
DESKPILOT_API_PORT=7071
# Background worker stays OFF until site grants and mailbox restrictions are configured.
DESKPILOT_WORKER_ENABLED=false
DESKPILOT_WORKER_MAILBOX=
DESKPILOT_AUTOMATION_SCHEDULE=0 */1 * * * *
DESKPILOT_POSTGRES_PROFILES=[]
