{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom/index.d.ts"
      ],
      "@fluentui/react": [
        "./node_modules/@fluentui/react/lib/index.d.ts"
      ],
      "react-chartjs-2": [
        "./node_modules/react-chartjs-2/dist/index.d.ts"
      ],
      "chart.js": [
        "./node_modules/chart.js/dist/types.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
