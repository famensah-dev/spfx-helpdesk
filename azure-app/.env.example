# Public SPA configuration. These values are compiled into the frontend; never add secrets.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_SHAREPOINT_SITE_URL=https://archwaysdigitalgh.sharepoint.com/sites/ithelpdesk
VITE_TICKETS_LIST_NAME=Tickets
# Optional: use the list GUID if it has been renamed or localized.
VITE_TICKETS_LIST_ID=
# Optional: GUID of the hidden User Information List used to resolve person fields.
VITE_USER_INFORMATION_LIST_ID=
# Recommended: delegated selected-site permission plus a read grant to this site.
VITE_GRAPH_SITE_SCOPE=Sites.Selected
